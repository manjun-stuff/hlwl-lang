{
    "name": "HLWL",
    "scopeName": "source.hlwl",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#hex-colors"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#structure-tags"
        },
        {
            "include": "#code-constructs"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.hlwl",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.hlwl",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "hex-colors": {
            "name": "constant.other.color.rgb-value.hlwl",
            "match": "#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?\\b"
        },
        "directives": {
            "name": "keyword.control.directive.hlwl",
            "match": "#[a-z_][a-z0-9_]*\\b"
        },
        "strings": {
            "name": "string.quoted.double.hlwl",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.hlwl",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.hlwl",
            "match": "\\b[0-9]+(?:\\.[0-9]+)?[fFuUiI]?\\b"
        },
        "structure-tags": {
            "begin": "(\\u003c/?)(page|scene|pkg|include|globals|helpers|code|layout|right_click_options|types|main\\.(?:func|loop|if_func_once|if_func_always|render|cpu_gpu)|gpu\\.(?:main_render_pipeline|material_shader|post_processing_shader|compute|uniform|buffer)|[a-zA-Z_][a-zA-Z0-9_.]*)\\b",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.begin.hlwl"
                },
                "2": {
                    "name": "entity.name.tag.hlwl"
                }
            },
            "end": "(\\u003e)",
            "endCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.end.hlwl"
                }
            },
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)",
                    "captures": {
                        "1": {
                            "name": "variable.other.attribute.hlwl"
                        },
                        "2": {
                            "name": "keyword.operator.assignment.hlwl"
                        }
                    }
                },
                {
                    "begin": "\\(",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.section.parens.begin.hlwl"
                        }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.parens.end.hlwl"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#code-constructs"
                        }
                    ]
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "name": "constant.language.boolean.hlwl",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "code-constructs": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#hex-colors"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#type-declarations"
                },
                {
                    "include": "#types-and-modifiers"
                },
                {
                    "include": "#namespaces"
                },
                {
                    "include": "#functions"
                },
                {
                    "include": "#constants"
                },
                {
                    "include": "#members"
                },
                {
                    "include": "#variables"
                },
                {
                    "include": "#operators"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.hlwl",
                    "match": "\\b(if|else|while|for|return|break|continue|switch|case|default)\\b"
                },
                {
                    "name": "storage.modifier.hlwl",
                    "match": "\\b(fn|cfn|pfn|var|cvar|state|vert|frag|comp)\\b"
                },
                {
                    "name": "constant.language.boolean.hlwl",
                    "match": "\\b(true|false|null)\\b"
                },
                {
                    "name": "entity.name.function.builtin.hlwl",
                    "match": "\\b(hlwlRunGPU)\\b"
                }
            ]
        },
        "type-declarations": {
            "match": "\\b(type|gtype|enum)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s*(:)\\s*([A-Z][a-zA-Z0-9_]*))?",
            "captures": {
                "1": {
                    "name": "keyword.declaration.type.hlwl"
                },
                "2": {
                    "name": "support.type.hlwl"
                },
                "3": {
                    "name": "punctuation.separator.inheritance.hlwl"
                },
                "4": {
                    "name": "support.type.inherited.hlwl"
                }
            }
        },
        "types-and-modifiers": {
            "patterns": [
                {
                    "match": "\\b(c|r|p)\\s*(\\()\\s*(?:([a-zA-Z_][a-zA-Z0-9_]*)(::?))?([A-Z][a-zA-Z0-9_]*)\\s*(\\))",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.pointer.hlwl"
                        },
                        "2": {
                            "name": "punctuation.section.parens.begin.hlwl"
                        },
                        "3": {
                            "name": "meta.namespace.hlwl"
                        },
                        "4": {
                            "name": "punctuation.accessor.hlwl"
                        },
                        "5": {
                            "name": "storage.type.hlwl"
                        },
                        "6": {
                            "name": "punctuation.section.parens.end.hlwl"
                        }
                    }
                },
                {
                    "match": "\\b(c|r|p)?(void|bool|int|uint|float|double|string|vec2|vec3|vec4|mat3|mat4|mat3x4)\\b",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.const.hlwl"
                        },
                        "2": {
                            "name": "storage.type.primitive.hlwl"
                        }
                    }
                },
                {
                    "match": "(\\u003c)\\s*(?:([a-zA-Z_][a-zA-Z0-9_]*)(::?))?([A-Z][a-zA-Z0-9_]*|void|bool|int|uint|float|double|string|vec2|vec3|vec4|mat3|mat4|mat3x4)\\s*(\\u003e)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.typeparameters.begin.hlwl"
                        },
                        "2": {
                            "name": "meta.namespace.hlwl"
                        },
                        "3": {
                            "name": "punctuation.accessor.hlwl"
                        },
                        "4": {
                            "name": "storage.type.hlwl"
                        },
                        "5": {
                            "name": "punctuation.definition.typeparameters.end.hlwl"
                        }
                    }
                },
                {
                    "name": "storage.type.hlwl",
                    "match": "(?<![.:])\\b[A-Z](?=[a-z0-9_]*[a-z])[a-zA-Z0-9_]*\\b(?!\\s*[\\u003c(])"
                }
            ]
        },
        "namespaces": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(::?)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*[\\u003c(])",
                    "captures": {
                        "1": {
                            "name": "meta.namespace.hlwl"
                        },
                        "2": {
                            "name": "punctuation.accessor.hlwl"
                        },
                        "3": {
                            "name": "entity.name.function.hlwl"
                        }
                    }
                },
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(::?)([A-Z](?=[a-z0-9_]*[a-z])[a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "meta.namespace.hlwl"
                        },
                        "2": {
                            "name": "punctuation.accessor.hlwl"
                        },
                        "3": {
                            "name": "storage.type.hlwl"
                        }
                    }
                },
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(::?)([A-Z][A-Z0-9_]{1,})\\b",
                    "captures": {
                        "1": {
                            "name": "meta.namespace.hlwl"
                        },
                        "2": {
                            "name": "punctuation.accessor.hlwl"
                        },
                        "3": {
                            "name": "variable.other.constant.hlwl"
                        }
                    }
                },
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(::?)([a-z_][a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "meta.namespace.hlwl"
                        },
                        "2": {
                            "name": "punctuation.accessor.hlwl"
                        },
                        "3": {
                            "name": "variable.other.readwrite.member.hlwl"
                        }
                    }
                },
                {
                    "match": "(?<=\\()\\s*([a-z][a-zA-Z0-9_]*)\\s*(?=\\))",
                    "captures": {
                        "1": {
                            "name": "meta.namespace.hlwl"
                        }
                    }
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.member.hlwl",
                    "match": "(?<=\\.)\\b_?[a-zA-Z][a-zA-Z0-9_]*\\b(?=\\s*[\\u003c(])"
                },
                {
                    "name": "entity.name.function.hlwl",
                    "match": "(?<![.:])\\b_?[a-zA-Z][a-zA-Z0-9_]*\\b(?=\\s*[\\u003c(])"
                }
            ]
        },
        "constants": {
            "name": "variable.other.constant.hlwl",
            "match": "(?<![.:])\\b[A-Z][A-Z0-9_]{1,}\\b(?!\\s*[\\u003c(])"
        },
        "members": {
            "name": "variable.other.readwrite.member.hlwl",
            "match": "(?<=\\.)\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?!\\s*[\\u003c(])"
        },
        "variables": {
            "name": "variable.other.readwrite.hlwl",
            "match": "(?<![.:])\\b[a-z_][a-zA-Z0-9_]*\\b(?!\\s*[\\u003c(])"
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.compound.hlwl",
                    "match": "(\\u002b=|-=|\\u002a=|/=|==|!=|\\u003c=|\\u003e=|&&|\\|\\|)"
                },
                {
                    "name": "keyword.operator.arithmetic.hlwl",
                    "match": "(=|\\u002b|-|\\u002a|/|\\u003c|\\u003e)"
                }
            ]
        }
    }
}