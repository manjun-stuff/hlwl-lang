{
    "name": "HLWL",
    "scopeName": "source.hlwl",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#blocks"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#namespaces"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#constants"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.hlwl",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.hlwl",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "name": "keyword.control.directive.hlwl",
                    "match": "#[a-z]+"
                }
            ]
        },
        "blocks": {
            "patterns": [
                {
                    "name": "entity.name.tag.block.hlwl",
                    "match": "</?(file|pkg|include|globals|helpers|code|layout|right_click_options|stdMath|types)\\b"
                },
                {
                    "name": "entity.name.tag.lifecycle.hlwl",
                    "match": "</?(main\\.(func|loop|if_func_once|if_func_always|render|cpu_gpu))\\b"
                },
                {
                    "name": "entity.name.tag.gpu.hlwl",
                    "match": "</?(gpu\\.(main_render_pipeline|material_shader|post_processing_shader|compute|uniform|buffer))\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.hlwl",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.hlwl",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hlwl",
                    "match": "\\b[0-9]+(\\.[0-9]+)?[fFuUiI]?\\b"
                }
            ]
        },
        "namespaces": {
            "patterns": [
                {
                    "comment": "Built-in core namespaces like io::WriteToConsole or ui:BUTTON",
                    "match": "\\b(std|ui|gpu|io)(::?)",
                    "captures": {
                        "1": {
                            "name": "support.class.namespace.hlwl"
                        },
                        "2": {
                            "name": "punctuation.accessor.hlwl"
                        }
                    }
                },
                {
                    "comment": "Scoped package imports like (easyGraphics)",
                    "match": "\\(([a-z][a-zA-Z0-9_]*)\\)",
                    "captures": {
                        "1": {
                            "name": "entity.name.namespace.hlwl"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.hlwl",
                    "match": "\\b(if|else|while|for|return|break|continue|switch|case|default)\\b"
                },
                {
                    "name": "storage.modifier.hlwl",
                    "match": "\\b(fn|cfn|var|cvar|state|vert|frag|comp)\\b"
                },
                {
                    "name": "constant.language.boolean.hlwl",
                    "match": "\\b(true|false|null)\\b"
                },
                {
                    "name": "support.function.builtin.hlwl",
                    "match": "\\b(hlwlRunGPU)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "comment": "Mutable and c-prefixed immutable primitive types",
                    "name": "storage.type.primitive.hlwl",
                    "match": "\\bc?(void|bool|int|uint|float|double|string|vec2|vec3|vec4|mat4)\\b"
                },
                {
                    "comment": "PascalCase Structs & Types (e.g., Vector3, Component)",
                    "name": "entity.name.type.hlwl",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                },
                {
                    "comment": "Declarator for types",
                    "name": "storage.type.hlwl",
                    "match": "\\b(type|gtype|enum)\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "comment": "PascalCase and _PascalCase functions",
                    "name": "entity.name.function.hlwl",
                    "match": "\\b_?[A-Z][a-zA-Z0-9_]*\\s*(?=\\()"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "comment": "SCREAMING_SNAKE_CASE Globals",
                    "name": "variable.other.constant.hlwl",
                    "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
                }
            ]
        }
    }
}