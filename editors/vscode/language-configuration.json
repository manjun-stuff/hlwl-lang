{
    "comments": {
        "lineComment": {
            "comment": "//"
        },
        "blockComment": [
            "/*",
            "*/"
        ]
    },
    "brackets": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "\"",
            "close": "\""
        },
        {
            "open": "'",
            "close": "'"
        },
        {
            "open": "<",
            "close": ">"
        }
    ],
    "folding": {
        "markers": {
            "start": "^\\s*(<[^/][^>]*>|.*\\{)\\s*$",
            "end": "^\\s*(</[^>]+>|\\})\\s*$"
        }
    }
}